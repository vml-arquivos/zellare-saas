# ─── Zelare Site Institucional — Variáveis de Ambiente ─────────────────────
# Copie este arquivo para .env e preencha os valores

# ── Banco de Dados (PostgreSQL do site) ──────────────────────────────────────
# O site usa SITE_DATABASE_URL; não coloque credenciais reais no repositório.
SITE_DATABASE_URL=<SITE_DATABASE_URL_FROM_COOLIFY>
DATABASE_URL=<SITE_DATABASE_URL_FROM_COOLIFY>

# ── Segurança ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=gere_um_secret_forte_aqui

# ── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
VITE_SITE_URL=https://zelare.casadf.com.br

# ── Stripe (Pagamentos / Doações) ───────────────────────────────────────────
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Opcional — para validar webhooks:
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Canais institucionais públicos ─────────────────────────────────────────
# Obrigatórios no build de produção; estes são os canais públicos históricos do Zelare.
VITE_PUBLIC_CONTACT_EMAIL=contato@zelare.com.br
VITE_PUBLIC_COMPLIANCE_EMAIL=denuncia@zelare.com.br
VITE_PUBLIC_PHONE=(61) 2123-4567
VITE_PUBLIC_ADDRESS=Brasília-DF

# ── Email (Opcional — notificações de contato) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@zelare.com.br
SMTP_PASSWORD=senha-de-app-configurada-no-ambiente
SMTP_FROM=contato@zelare.com.br

# ── Analytics (Opcional) ────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
