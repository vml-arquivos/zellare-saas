// ============================================================================
// 2. ESTRUTURA ORGANIZACIONAL
// ============================================================================

/// Mantenedora: Organização raiz que gerencia múltiplas unidades
model Mantenedora {
  id      String  @id @default(cuid())
  name    String  @db.VarChar(255)
  email   String  @unique @db.VarChar(255)
  phone   String? @db.VarChar(20)
  website String? @db.VarChar(255)

  // Identificação fiscal (genérica — não presume mais Brasil/CNPJ)
  // cnpj mantido por compatibilidade com dados existentes (COCRIS e outros tenants BR já migrados)
  cnpj      String?   @unique @db.VarChar(18)
  taxIdType TaxIdType @default(CNPJ)
  taxId     String?   @db.VarChar(50) // valor livre: CNPJ, EIN, NIF, VAT, ou vazio p/ instituições sem doc. fiscal formal
  country   String    @default("BR") @db.VarChar(2) // ISO 3166-1 alpha-2

  // Endereço
  address String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(2)
  zipCode String? @db.VarChar(10)

  // Status e configurações
  isActive Boolean @default(true)
  plan     String  @default("basic") // basic, professional, enterprise
  maxUnits Int     @default(1)
  maxUsers Int     @default(50)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(255)
  updatedBy String?  @db.VarChar(255)

  // Relações
  branding                    TenantBranding?
  featureFlags                TenantFeatureFlag[]
  pedagogicalFrameworks       PedagogicalFramework[]
  contentUploads              InstitutionContentUpload[]
  units                       Unit[]
  rdicProfiles                RdicDocumentProfile[]       @relation("MantenedoraRdicProfiles")
  defaultRdicProfileId        String?                     @unique
  defaultRdicProfile          RdicDocumentProfile?        @relation("MantenedoraDefaultRdicProfile", fields: [defaultRdicProfileId], references: [id], onDelete: SetNull)
  users                       User[]
  roles                       Role[]
  children                    Child[]
  curriculumMatrices          CurriculumMatrix[]
  plannings                   Planning[]
  diaryEvents                 DiaryEvent[]
  attendances                 Attendance[]
  materialRequests            MaterialRequest[]
  reportBases                 ReportBase[]
  aiContexts                  AIContext[]
  rdicDocumentEvents          RdicDocumentEvent[]
  childEvidences              ChildEvidence[]
  auditLogs                   AuditLog[]
  pedidosCompra               PedidoCompra[]
  solicitacoesCorrecao        SolicitacaoCorrecao[]
  fornecedores                Fornecedor[]
  arquivos                    Arquivo[]
  coordenacoesReuniao         CoordenacaoReuniao[]
  formacoes                   Formacao[]
  atendimentosPais            AtendimentoPais[]
  relatoriosFoto              RelatorioFoto[]
  rdixTemplates               RDIXTemplate[]
  rdixInstancias              RDIXInstancia[]
  alertasOperacionais         AlertaOperacional[]
  templatesOffline            TemplateOffline[]
  recadosTurma                RecadoTurma[]
  classroomPosts              ClassroomPost[]
  materiais                   Material[]
  cardapios                   Cardapio[]
  acompanhamentosNutricionais AcompanhamentoNutricional[]
  iaRequests                  IaRequest[]                 @relation("MantenedoraIaRequests")
  empresasTransporte          EmpresaTransporte[]
  evidenceReviewTasks         EvidenceReviewTask[]
  evidenceLinks               EvidenceLink[]
  childGoals                  ChildGoal[]
  supportActions              SupportAction[]
  familyConversations         FamilyConversation[]
  familyAttachments           FamilyAttachment[]
  familyContributions         FamilyContribution[]
  consentGrants               ConsentGrant[]
  publicationRecords          PublicationRecord[]
  acknowledgments             Acknowledgment[]
  communicationPreferences    CommunicationPreference[]
  domainOutboxEvents          DomainOutboxEvent[]
  operationalPresenceSessions OperationalPresenceSession[]
  operationalPresenceEvents   OperationalPresenceEvent[]
  staffingAssignments         StaffingAssignment[]
  staffQualifications         StaffQualification[]
  substitutionRequests        SubstitutionRequest[]
  ratioPolicies               RatioPolicy[]
  ratioRuleVersions           RatioRuleVersion[]
  ratioSnapshots              RatioSnapshot[]
  ratioBreaches               RatioBreach[]
  facilitySpaces              FacilitySpace[]
  facilityAssets              FacilityAsset[]
  assetMovements              AssetMovement[]
  assetDocuments              AssetDocument[]
  assetMeterReadings          AssetMeterReading[]
  maintenanceRequests         MaintenanceRequest[]
  workOrders                  WorkOrder[]
  workOrderAssignments        WorkOrderAssignment[]
  workOrderStatusEvents       WorkOrderStatusEvent[]
  workOrderAttachments        WorkOrderAttachment[]
  serviceLevelPolicies        ServiceLevelPolicy[]
  serviceLevelClockEvents     ServiceLevelClockEvent[]
  preventiveMaintenancePlans  PreventiveMaintenancePlan[]
