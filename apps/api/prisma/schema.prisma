  classroom Classroom @relation(fields: [classroomId], references: [id])
  professor User      @relation("MicrogestosRegistrados", fields: [professorId], references: [id])

  @@index([childId])
  @@index([classroomId])
  @@index([unitId])
  @@index([mantenedoraId])
  @@index([data])
