/// Presença operacional em tempo próximo do real; não substitui Attendance.
enum Onda2PresenceSessionStatus {
  OPEN
  CLOSED
  RECONCILING
}

enum Onda2PresenceEventType {
  CHECK_IN
  CHECK_OUT
  MOVE
  CORRECTION
}

enum Onda2PresenceEventStatus {
  ACCEPTED
  REJECTED
  RECONCILED
  EXCEPTION
}

enum Onda2AssignmentStatus {
  DRAFT
  PROPOSED
  PUBLISHED
  CANCELLED
}

enum Onda2SubstitutionStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

enum Onda2ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum Onda2RatioState {
  UNKNOWN
  COMPLIANT
  ATTENTION
  VIOLATION
}

enum Onda2BreachStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum Onda2SpaceStatus {
  AVAILABLE
  LIMITED
  BLOCKED
  UNKNOWN
}

enum Onda2AssetStatus {
  OPERATIONAL
  LIMITED
  OUT_OF_SERVICE
  RETIRED
}

enum Onda2Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Onda2MaintenanceRequestStatus {
  SUBMITTED
  TRIAGE
  REJECTED
  DUPLICATE
  APPROVED
  CONVERTED
  CLOSED
}

enum Onda2WorkOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  VALIDATED
  CLOSED
  REOPENED
  CANCELLED
}

enum Onda2PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

enum Onda2ExecutionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Onda2InspectionResult {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
  NOT_OBSERVED
}

enum Onda2InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Onda2NonconformityStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  CLOSED
}

model OperationalPresenceSession {
  id            String                     @id @default(cuid())
  mantenedoraId String
  unitId        String
  spaceId       String?
  classroomId   String?
  sessionDate   DateTime
  status        Onda2PresenceSessionStatus @default(OPEN)
  openedAt      DateTime                   @default(now())
  closedAt      DateTime?
  createdBy     String                      @db.VarChar(255)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  mantenedora Mantenedora @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, spaceId, sessionDate])
  @@index([mantenedoraId, unitId, status])
  @@index([sessionDate])
  @@map("operational_presence_session")
}

