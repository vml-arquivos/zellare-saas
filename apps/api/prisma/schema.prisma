// ============================================================================
// 25. CATÁLOGO DE MATERIAIS
// ============================================================================

/// Material do catálogo da mantenedora (referência para requisições e pedidos de compra)
model Material {
  id            String @id @default(cuid())
  mantenedoraId String

  // Identificação (nomes em inglês para compatibilidade com o service)
  code            String   @db.VarChar(50)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  category        String   @db.VarChar(50) // Ex: PEDAGOGICO, HIGIENE, ADMINISTRATIVO
  unit            String?  @db.VarChar(50) // unidade de medida: unidade, caixa, pacote
  referencePrice  Decimal? @db.Decimal(10, 2)
  defaultSupplier String?  @db.VarChar(255)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantenedora  Mantenedora           @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  requestItems MaterialRequestItem[]

  @@unique([mantenedoraId, code])
  @@index([mantenedoraId])
  @@index([category])
  @@index([isActive])
}

// ============================================================================
// 26. CARDÁPIO E NUTRIÇÃO
// ============================================================================

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
}

enum TipoRefeicao {
  CAFE_MANHA
  ALMOCO
  LANCHE_TARDE
  JANTAR
}

/// Cardápio semanal da unidade
model Cardapio {
  id            String   @id @default(cuid())
  mantenedoraId String
  unitId        String
  /// Semana de referência: primeiro dia da semana (segunda-feira) no formato YYYY-MM-DD
  semana        String   @db.VarChar(10)
  titulo        String?  @db.VarChar(255)
  observacoes   String?  @db.Text
  publicado     Boolean  @default(false)
  createdBy     String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mantenedora Mantenedora        @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  unit        Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  refeicoes   CardapioRefeicao[]

  @@unique([unitId, semana])
  @@index([mantenedoraId])
  @@index([unitId])
  @@index([semana])
  @@map("cardapio")
}

/// Refeição de um dia dentro de um cardápio semanal
model CardapioRefeicao {
  id                     String       @id @default(cuid())
  cardapioId             String
  diaSemana              DiaSemana
  tipoRefeicao           TipoRefeicao
  observacoes            String?      @db.Text
  /// Referência opcional à configuração de refeição customizada da unidade (Fase 2)
  configuracaoRefeicaoId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  cardapio             Cardapio              @relation(fields: [cardapioId], references: [id], onDelete: Cascade)
  configuracaoRefeicao ConfiguracaoRefeicao? @relation(fields: [configuracaoRefeicaoId], references: [id], onDelete: SetNull)
  itens                CardapioItem[]

  @@unique([cardapioId, diaSemana, tipoRefeicao])
  @@index([cardapioId])
  @@index([configuracaoRefeicaoId])
  @@map("cardapio_refeicao")
}

/// Item (alimento/preparação) de uma refeição do cardápio
model CardapioItem {
  id         String   @id @default(cuid())
  refeicaoId String
  nome       String   @db.VarChar(255)
  quantidade Decimal? @db.Decimal(10, 3)
  unidade    String?  @db.VarChar(50)

  /// Informação nutricional por porção (opcional)
  calorias     Decimal? @db.Decimal(8, 2)
  proteinas    Decimal? @db.Decimal(8, 2)
  carboidratos Decimal? @db.Decimal(8, 2)
  gorduras     Decimal? @db.Decimal(8, 2)
  fibras       Decimal? @db.Decimal(8, 2)
  sodio        Decimal? @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refeicao CardapioRefeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  @@index([refeicaoId])
  @@map("cardapio_item")
}

// ─── Módulo Nutricionista: Banco de Alimentos ────────────────────────────────

enum CategoriaAlimento {
  CEREAIS_GRAOS
  LEGUMINOSAS
  PROTEINAS
  LATICINIOS
  FRUTAS
  VERDURAS_LEGUMES
  GORDURAS_OLEOS
  ACUCARES_DOCES
  BEBIDAS
  PREPARACOES
  OLEAGINOSAS
  EMBUTIDOS
  FARINHAS_AMIDOS
  TEMPEROS_CONDIMENTOS
  SOPAS_CALDOS
  OUTROS
}

/// Banco de alimentos com informações nutricionais por 100g
model Alimento {
  id            String            @id @default(cuid())
  nome          String            @db.VarChar(255)
  categoria     CategoriaAlimento
  unidadePadrao String            @default("g") @db.VarChar(20)
  porcaoPadrao  Decimal           @default(100) @db.Decimal(8, 2)
  descricao     String?           @db.Text

  /// Valores nutricionais por 100g do alimento
  calorias100g     Decimal @db.Decimal(8, 2)
  proteinas100g    Decimal @db.Decimal(8, 3)
  carboidratos100g Decimal @db.Decimal(8, 3)
  gorduras100g     Decimal @db.Decimal(8, 3)
  fibras100g       Decimal @default(0) @db.Decimal(8, 3)
  sodio100g        Decimal @default(0) @db.Decimal(8, 3)

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome])
  @@index([categoria])
  @@index([nome])
  @@map("alimento")
}

// ─── Módulo Nutricionista: Refeições Configuráveis por Unidade (Fase 2) ───────

/// Configuração de refeições personalizadas por unidade escolar
/// Permite que cada unidade defina seus próprios tipos de refeição
/// (ex: Colação, Lanche da Manhã, Café da Tarde)
model ConfiguracaoRefeicao {
  id     String @id @default(cuid())
  unitId String

  /// Nome da refeição (ex: "Colação", "Lanche da Manhã", "Café da Tarde")
  nome    String  @db.VarChar(100)
  /// Horário sugerido da refeição no formato HH:MM (ex: "09:30")
  horario String? @db.VarChar(5)
  /// Ordem de exibição na interface (0 = primeira)
  ordem   Int     @default(0)
  ativo   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit      Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  refeicoes CardapioRefeicao[]

  @@unique([unitId, nome])
  @@index([unitId])
  @@index([ativo])
  @@map("configuracao_refeicao")
}

// ============================================================================
// 28. ACOMPANHAMENTO INDIVIDUAL NUTRICIONAL
// ============================================================================

/// Status do caso de acompanhamento nutricional individual
enum StatusCasoNutricional {
  MONITORAMENTO
  ATENCAO_MODERADA
  ATENCAO_ALTA
  CRITICO
}

/// Acompanhamento nutricional individual de uma criança
/// Criado pela Nutricionista para crianças que precisam de atenção especial
model AcompanhamentoNutricional {
  id            String @id @default(cuid())
  mantenedoraId String @map("mantenedora_id")
  unitId        String @map("unit_id")
  childId       String @map("child_id")
  criadoPorId   String @map("criado_por_id") @db.VarChar(255)

  // Identificação do caso
  motivoAcompanhamento String                @map("motivo_acompanhamento") @db.Text
  statusCaso           StatusCasoNutricional @default(MONITORAMENTO) @map("status_caso")
  ativo                Boolean               @default(true)

  // Plano de cuidado
  objetivos              String?   @db.Text
  condutaAtual           String?   @map("conduta_atual") @db.Text
  restricoesOperacionais String?   @map("restricoes_operacionais") @db.Text
  substituicoesSeguras   String?   @map("substituicoes_seguras") @db.Text
  orientacoesProfCozinha String?   @map("orientacoes_prof_cozinha") @db.Text
  frequenciaRevisao      String?   @map("frequencia_revisao") @db.VarChar(100)
  proximaReavaliacao     DateTime? @map("proxima_reavaliacao")

  // Timestamps
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Relações
  mantenedora Mantenedora? @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  child       Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId]) // uma criança tem no máximo 1 caso ativo por vez
  @@index([mantenedoraId])
  @@index([unitId])
  @@index([childId])
  @@index([statusCaso])
  @@index([ativo])
  @@index([proximaReavaliacao])
  @@map("acompanhamento_nutricional")
}

// ============================================================
// MÓDULO DE DESENVOLVIMENTO — Relatório Individual
// ============================================================

/// Status do Relatório de Desenvolvimento Individual da Criança (RDIC)
enum RdicStatus {
  RASCUNHO
  EM_REVISAO
  DEVOLVIDO
  APROVADO
  FINALIZADO
  PUBLICADO
}

model DevelopmentReport {
  id          String     @id @default(cuid())
  childId     String
  authorId    String
  classroomId String
  unitId      String
  period      String
  content     String
  status      RdicStatus @default(RASCUNHO)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  child     Child     @relation(fields: [childId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  unit      Unit      @relation(fields: [unitId], references: [id])

  @@index([childId, createdAt(sort: Desc)])
  @@index([classroomId, period])
  @@map("development_report")
}

// ============================================================================
// MICROGESTOS, CHILD STATS E ALERTAS — feat/diario-zero-digitacao
// ============================================================================

enum MicrogestoCategoria {
  DESENVOLVIMENTO_MOTOR
  LINGUAGEM_COMUNICACAO
  INTERACAO_SOCIAL
  REGULACAO_EMOCIONAL
  COGNICAO_EXPLORACAO
  CUIDADO_SAUDE
  ALIMENTACAO
  AUTONOMIA
}

enum MicrogestoNivel {
  ALCANCADO
  EM_DESENVOLVIMENTO
  REQUER_ATENCAO
}

enum AlertaTipo {
  EVASAO_RISCO
  FALTAS_CONSECUTIVAS
  FALTAS_FREQUENTES
  PADRAO_COMPORTAMENTO_NEGATIVO
  PADRAO_ALIMENTACAO_NEGATIVO
  PADRAO_SAUDE_NEGATIVO
}

enum AlertaStatus {
  ATIVO
  LIDO
  RESOLVIDO
}

model MicrogestoRegistro {
  id               String              @id @default(cuid())
