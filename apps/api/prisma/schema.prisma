model EvidenceReviewTask {
  id            String                @id @default(cuid())
  mantenedoraId String
  unitId        String
  childId       String
  evidenceId    String
  assignedTo    String?               @db.VarChar(255)
  createdBy     String                @db.VarChar(255)
  resolvedBy    String?               @db.VarChar(255)
  status        Onda1ReviewTaskStatus @default(OPEN)
  priority      Onda1ReviewPriority   @default(NORMAL)
  dueAt         DateTime?
  version       Int                   @default(1)
  requestNote   String?               @db.Text
  decisionNote  String?               @db.Text
  actionTaken   String?               @db.Text
  resolvedAt    DateTime?
  archivedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  mantenedora Mantenedora   @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  unit        Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  child       Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  evidence    ChildEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([mantenedoraId, unitId, status])
  @@index([childId, status, dueAt])
  @@index([evidenceId])
  @@index([assignedTo, status])
  @@map("evidence_review_task")
}

model EvidenceLink {
  id            String   @id @default(cuid())
  mantenedoraId String
  unitId        String
  childId       String
  evidenceId    String
  targetType    String   @db.VarChar(60)
  targetId      String   @db.VarChar(255)
  relationType  String   @db.VarChar(60)
