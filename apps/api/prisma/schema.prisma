model ChildProfileStats {
  id                      String    @id @default(cuid())
  childId                 String    @unique
  unitId                  String
  mantenedoraId           String
  totalDiasRegistrados    Int       @default(0)
  totalFaltas             Int       @default(0)
  faltasUltimos30Dias     Int       @default(0)
  faltasConsecutivas      Int       @default(0)
  ultimaPresenca          DateTime?
  totalMicrogestos        Int       @default(0)
  microgestosCategoria    Json      @default("{}")
  microgestosNivel        Json      @default("{}")
  totalObservacoes        Int       @default(0)
  observacoesPorCategoria Json      @default("{}")
  alertasAtivos           Int       @default(0)

  // Campos de evolução pedagógica — série histórica
  obsUltimos7dias        Int       @default(0) @map("obs_ultimos_7_dias")
  obsUltimos30dias       Int       @default(0) @map("obs_ultimos_30_dias")
  participacaoMedia      Float?    @map("participacao_media")
  ultimaObservacao       DateTime? @map("ultima_observacao")
  tendenciaComportamento String?   @map("tendencia_comportamento") // ESTAVEL, MELHORA, ATENCAO

  ultimaAtualizacao DateTime @default(now()) @updatedAt

  child Child @relation(fields: [childId], references: [id])

  @@index([unitId])
  @@index([mantenedoraId])
  @@map("child_profile_stats")
}

model AlertaAluno {
  id            String       @id @default(cuid())
  childId       String
  classroomId   String
  unitId        String
  mantenedoraId String?
  tipo          AlertaTipo
  status        AlertaStatus @default(ATIVO)
  titulo        String       @db.VarChar(255)
  descricao     String       @db.Text
  dados         Json         @default("{}")
  geradoEm      DateTime     @default(now())
  lidoEm        DateTime?
  resolvidoEm   DateTime?
  resolvidoPor  String?

  child     Child     @relation(fields: [childId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@index([childId])
  @@index([classroomId])
  @@index([unitId])
  @@index([status])
  @@map("alerta_aluno")
