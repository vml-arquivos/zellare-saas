  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([mantenedoraId, unitId, occurredAt])
  @@index([spaceId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([status, occurredAt])
  @@map("operational_presence_event")
}

