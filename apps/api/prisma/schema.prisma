  child       Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([unitId, classroomId, childId, reportType, period, startDate])
  @@index([mantenedoraId])
  @@index([unitId])
  @@index([classroomId])
  @@index([childId])
  @@index([reportType])
  @@index([startDate])
}

