/// Empresa de transporte escolar cadastrada pela secretaria
enum TaxIdType {
  CNPJ // Brasil — pessoa jurídica
  CPF // Brasil — pessoa física (ONGs pequenas, autônomos)
  EIN // EUA
  NIF // Portugal / vários países EU
  VAT // Europa em geral
  OTHER
  NONE // instituição sem documento fiscal formal (ex: iniciativa comunitária)
}

/// Identidade visual e de domínio de cada Mantenedora (tenant).
/// Preenche a lacuna entre o que o README promete ("personalização total")
/// e o que existia no banco até esta migration (nada).
model TenantBranding {
  id            String @id @default(cuid())
  mantenedoraId String @unique

  displayName String  @db.VarChar(255) // nome comercial exibido (pode diferir da razão social)
  slogan      String? @db.VarChar(255)
  logoUrl     String? @db.Text
  faviconUrl  String? @db.Text

  primaryColor   String? @db.VarChar(7) // hex, ex: #1E3A8A
  secondaryColor String? @db.VarChar(7)

  customDomain   String? @unique @db.VarChar(255) // ex: app.escolaxyz.com.br
  domainVerified Boolean @default(false)

  emailFromName    String? @db.VarChar(255)
  emailFromAddress String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantenedora Mantenedora @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)

  @@index([customDomain])
}

/// Feature flag real por tenant (substitui o mapa estático hoje fixo só por role em FeatureFlagsService).
/// Permite ligar/desligar módulos inteiros por plano contratado, sem deploy novo.
model TenantFeatureFlag {
  id            String  @id @default(cuid())
  mantenedoraId String
  flagKey       String  @db.VarChar(100) // ex: "modulo_estoque", "ia_assistiva", "portal_familia"
  enabled       Boolean @default(false)
  config        Json? // parâmetros específicos da flag, quando necessário

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantenedora Mantenedora @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)

  @@unique([mantenedoraId, flagKey])
  @@index([mantenedoraId])
}

// ============================================================================
// MOTOR DE FRAMEWORK PEDAGÓGICO PLUGÁVEL
// Generaliza o que hoje está fixo em CurriculumMatrixEntry (BNCC + Currículo em
// Movimento DF) para qualquer abordagem pedagógica, de qualquer país/rede.
// mantenedoraId nulo = framework oficial oferecido pela própria plataforma
// (biblioteca curada), disponível para qualquer tenant escolher/clonar.
// ============================================================================

/// Um framework pedagógico completo: um documento normativo oficial
/// (BNCC, EYFS, currículo regional) ou uma abordagem própria da instituição
/// (Montessori adaptado, Reggio Emilia customizado, currículo autoral).
model PedagogicalFramework {
  id            String  @id @default(cuid())
  mantenedoraId String? // null = biblioteca global da plataforma

  name        String  @db.VarChar(255) // "BNCC + Currículo em Movimento DF", "EYFS 2024"
  country     String? @db.VarChar(2) // ISO 3166-1 alpha-2, null se não-nacional (ex: Montessori)
  region      String? @db.VarChar(100) // "DF", "SP"... para currículos regionais dentro de um país
  isOfficial  Boolean @default(false) // documento normativo oficial vs. abordagem própria
  version     Int     @default(1)
  description String? @db.Text
  sourceUrl   String? @db.VarChar(500)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(255)

  mantenedora Mantenedora?         @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  dimensions  FrameworkDimension[]
  objectives  FrameworkObjective[]

  @@index([mantenedoraId])
  @@index([country])
  @@index([isActive])
}

/// As "áreas de aprendizagem" do framework — o que hoje é o enum fixo
/// CampoDeExperiencia (os 5 campos da BNCC) vira dado configurável.
model FrameworkDimension {
  id          String  @id @default(cuid())
  frameworkId String
  code        String  @db.VarChar(50) // "EO" (Eu, o Outro e o Nós) ou "Communication" (EYFS)
  name        String  @db.VarChar(255)
  description String? @db.Text
  order       Int     @default(0)

  framework  PedagogicalFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  objectives FrameworkObjective[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
}

/// Objetivo de aprendizagem individual dentro de uma dimensão do framework.
/// Substitui objetivoBNCC/objetivoCurriculo como texto fixo em CurriculumMatrixEntry.
model FrameworkObjective {
  id          String  @id @default(cuid())
  frameworkId String
  dimensionId String
  code        String? @db.VarChar(20) // "EI01EO03" ou equivalente em outro framework
  ageRangeMin Int // em meses — granularidade fina para 0 a 6 anos
  ageRangeMax Int
  text        String  @db.Text // transcrição literal do objetivo normativo

  framework               PedagogicalFramework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  dimension               FrameworkDimension      @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  curriculumMatrixEntries CurriculumMatrixEntry[]

  @@index([frameworkId])
  @@index([dimensionId])
  @@index([ageRangeMin, ageRangeMax])
}

enum ContentUploadType {
  PLANO_DE_AULA
  PROJETO_PEDAGOGICO
  MATERIAL_DIDATICO
  CURRICULO_PROPRIO
  OUTRO
}

enum ContentUploadStatus {
  ENVIADO // arquivo recebido, aguardando processamento
  PROCESSANDO // parser/IA extraindo estrutura
  PRONTO_PARA_REVISAO // extraído, aguardando validação humana
  APROVADO // virou PlanningTemplate/FrameworkObjective utilizável
  REJEITADO
}

/// Permite que QUALQUER instituição suba seus próprios planos de aula, projetos
/// e materiais já em uso, para virarem templates utilizáveis na plataforma —
/// reaproveitando o parser de PDF que já existe hoje só para matriz curricular
/// (módulo curriculum-import), generalizado para qualquer documento pedagógico.
model InstitutionContentUpload {
  id            String @id @default(cuid())
  mantenedoraId String

  type     ContentUploadType
  title    String            @db.VarChar(255)
  fileUrl  String            @db.Text
  fileName String            @db.VarChar(255)
  mimeType String            @db.VarChar(100)

  status        ContentUploadStatus @default(ENVIADO)
  extractedData Json? // resultado estruturado do parser/IA, revisável antes de aprovar
  reviewNotes   String?             @db.Text

  // Quando aprovado, vira um destes (rastreabilidade da origem)
  resultingPlanningTemplateId String?
  resultingFrameworkId        String?

  uploadedBy String    @db.VarChar(255)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?
  reviewedBy String?   @db.VarChar(255)

  mantenedora Mantenedora @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)

  @@index([mantenedoraId])
  @@index([status])
  @@index([type])
}

model EmpresaTransporte {
  id            String   @id @default(cuid())
  mantenedoraId String
  unitId        String?
  nome          String   @db.VarChar(255)
  cnpj          String?  @db.VarChar(20)
  telefone      String?  @db.VarChar(20)
  responsavel   String?  @db.VarChar(255)
  placa         String?  @db.VarChar(20)
  observacoes   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?  @db.VarChar(255)
  updatedBy     String?  @db.VarChar(255)

  mantenedora Mantenedora @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  unit        Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([mantenedoraId, unitId, nome])
  @@index([mantenedoraId])
  @@index([unitId])
  @@index([isActive])
}

/// Unidade: Creche/Escola dentro de uma mantenedora
model Unit {
  id            String @id @default(cuid())
  mantenedoraId String
  name          String @db.VarChar(255)
  code          String @db.VarChar(50)

  // Endereço
  address String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(2)
  zipCode String? @db.VarChar(10)

  // Contato
  email String? @db.VarChar(255)
  phone String? @db.VarChar(20)

  // Configurações pedagógicas
  capacity        Int      @default(100)
  ageGroupsServed String   @default("0-4") // Faixa etária atendida
  /// Datas não letivas configuradas pela unidade (feriados, recessos, etc.)
  /// Formato: array de strings "YYYY-MM-DD" no fuso America/Sao_Paulo
  /// Exemplo: ["2026-04-21", "2026-06-19"] (Tiradentes, Corpus Christi)
  nonSchoolDays   String[] @default([])

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(255)
  updatedBy String?  @db.VarChar(255)

  // Relações
  mantenedora          Mantenedora           @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  users                User[]
