  attendances          Attendance[]
  materialRequests     MaterialRequest[]
  stockItems           StockItem[]
  reportBases          ReportBase[]
  auditLogs            AuditLog[]
  userRoleUnitScopes   UserRoleUnitScope[]
  pedidosCompra        PedidoCompra[]
  solicitacoesCorrecao SolicitacaoCorrecao[]
  aiContexts           AIContext[]
  rdicProfileId        String?
  rdicProfile          RdicDocumentProfile?  @relation("UnitRdicProfile", fields: [rdicProfileId], references: [id], onDelete: SetNull)
