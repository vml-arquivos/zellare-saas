// ============================================================================
// 22. RECADOS DE TURMA (Comunicação professor → responsáveis)
// ============================================================================

/// Recado enviado pela coordenação para professores/turmas
model RecadoTurma {
  id            String  @id @default(cuid())
  mantenedoraId String  @map("mantenedora_id")
  unitId        String  @map("unit_id")
  classroomId   String? @map("classroom_id")
  criadoPorId   String  @map("criado_por_id") @db.VarChar(255)
  professorId   String? @map("professor_id") @db.VarChar(255)

  titulo       String  @db.VarChar(255)
  mensagem     String  @db.Text
  importante   Boolean @default(false)
  destinatario String  @default("TODAS_PROFESSORAS") @db.VarChar(50)

  expiresAt    DateTime? @map("expires_at")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  mantenedora Mantenedora     @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  leituras    RecadoLeitura[]

  @@index([mantenedoraId])
  @@index([unitId])
  @@index([classroomId])
  @@index([criadoPorId])
  @@index([destinatario])
  @@index([expiresAt])
  @@map("recado_turma")
}

/// Confirmação de leitura de recado por professor
model RecadoLeitura {
  id       String   @id @default(cuid())
  recadoId String   @map("recado_id")
  userId   String   @map("user_id") @db.VarChar(255)
  lidoEm   DateTime @default(now()) @map("lido_em")

  recado RecadoTurma @relation(fields: [recadoId], references: [id], onDelete: Cascade)

  @@unique([recadoId, userId])
  @@index([recadoId])
  @@index([userId])
  @@map("recado_leitura")
}

// ============================================================================
// 23. POSTAGENS PEDAGÓGICAS (ClassroomPost)
// ============================================================================

/// Postagem pedagógica de uma turma (tarefa, atividade, aviso, etc.)
model ClassroomPost {
  id            String  @id @default(cuid())
  mantenedoraId String  @map("mantenedora_id")
  unitId        String  @map("unit_id")
  classroomId   String  @map("classroom_id")
  createdBy     String  @map("created_by") @db.VarChar(255)
  planningId    String? @map("planning_id")

  title   String    @db.VarChar(255)
  content String?   @db.Text
  type    String    @default("TAREFA") @map("type") @db.VarChar(50)
  status  String    @default("PUBLICADO") @map("status") @db.VarChar(50)
  dueDate DateTime? @map("due_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mantenedora  Mantenedora              @relation(fields: [mantenedoraId], references: [id], onDelete: Cascade)
  classroom    Classroom                @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  files        ClassroomPostFile[]
  performances StudentPostPerformance[]

  @@index([mantenedoraId])
  @@index([unitId])
  @@index([classroomId])
  @@index([createdBy])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@map("classroom_post")
}

/// Arquivo anexado a uma postagem pedagógica
model ClassroomPostFile {
  id     String @id @default(cuid())
  postId String @map("post_id")
  url    String @db.VarChar(1024)
  name   String @map("nome_original") @db.VarChar(255)
  type   String @map("mime_type") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  post ClassroomPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("classroom_post_file")
}

/// Desempenho individual de aluno em uma postagem pedagógica
model StudentPostPerformance {
  id        String @id @default(cuid())
  postId    String @map("post_id")
  childId   String @map("child_id")
  createdBy String @map("created_by") @db.VarChar(255)

  performance String? @db.VarChar(50)
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post  ClassroomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  child Child         @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([postId, childId])
  @@index([postId])
  @@index([childId])
  @@map("student_post_performance")
}

// ============================================================================
// 24. OBSERVAÇÕES DE DESENVOLVIMENTO INDIVIDUAL
// ============================================================================

/// Observação de desenvolvimento individual de uma criança
model DevelopmentObservation {
  id          String  @id @default(cuid())
  childId     String  @map("child_id")
  classroomId String? @map("classroom_id")
  createdBy   String  @map("created_by") @db.VarChar(255)

  // Classificação
  category String   @default("GERAL") @db.VarChar(100)
  date     DateTime @default(now())

  // Campos de observação (todos opcionais)
  behaviorDescription   String?  @map("behavior_description") @db.Text
  socialInteraction     String?  @map("social_interaction") @db.Text
  emotionalState        String?  @map("emotional_state") @db.Text
  motorSkills           String?  @map("motor_skills") @db.Text
  cognitiveSkills       String?  @map("cognitive_skills") @db.Text
  languageSkills        String?  @map("language_skills") @db.Text
  healthNotes           String?  @map("health_notes") @db.Text
  dietaryNotes          String?  @map("dietary_notes") @db.Text
  sleepPattern          String?  @map("sleep_pattern") @db.Text
  learningProgress      String?  @map("learning_progress") @db.Text
  planningParticipation String?  @map("planning_participation") @db.Text
  interests             String?  @db.Text
  challenges            String?  @db.Text
  psychologicalNotes    String?  @map("psychological_notes") @db.Text
  developmentAlerts     String?  @map("development_alerts") @db.Text
  recommendations       String?  @db.Text
  nextSteps             String?  @map("next_steps") @db.Text
  atividadeArquivoUrl   String?  @map("atividade_arquivo_url") @db.Text
  atividadeArquivoNome  String?  @map("atividade_arquivo_nome") @db.VarChar(255)
  tags                  Json     @default("[]")
  indicadores           Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

