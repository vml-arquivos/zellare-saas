  "scripts": {
    "build": "nest build && node dist/src/scripts/generate-openapi.js && node scripts/copy-data-to-dist.js",
    "openapi:generate": "nest build && node dist/src/scripts/generate-openapi.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:safe": "bash scripts/migrate-deploy.sh",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/fixtures/synthetic-seed.mjs",
    "snapshot:manifest": "bash scripts/snapshot-manifest.sh",
    "security:artifacts": "node scripts/check-sensitive-artifacts.mjs",
    "test": "jest",
    "seed:synthetic": "ALLOW_SYNTHETIC_SEED=true node scripts/fixtures/synthetic-seed.mjs",
    "typecheck": "tsc --noEmit",
    "prepush": "npm run typecheck"
  },
